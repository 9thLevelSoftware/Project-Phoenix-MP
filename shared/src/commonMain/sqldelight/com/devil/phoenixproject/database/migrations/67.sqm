-- Migration 67: per-exercise power-loss target config (issue #1392, packet P4
-- remainder). Additive only (SQLite API-26): no DROP COLUMN, no ON CONFLICT
-- DO UPDATE, no INSERT OR REPLACE on parents. An absent row means inert
-- REP_TARGET defaults with NULLs — missing config is NULL, never a fabricated
-- zero, and legacy rows keep their REP meaning. The row is local-only: no sync
-- wire semantics. Fresh installs get the identical shape from PhoenixDatabase.sq.
-- Mirrors 67.sqm exactly in MigrationStatements.getMigrationStatements(67).

CREATE TABLE IF NOT EXISTS PowerLossExerciseConfig (
    routine_exercise_id TEXT NOT NULL PRIMARY KEY,
    format_version INTEGER NOT NULL DEFAULT 1,
    target_mode TEXT NOT NULL,
    threshold_percent INTEGER NOT NULL,
    max_working_reps INTEGER,
    require_two_consecutive INTEGER NOT NULL DEFAULT 0 CHECK(require_two_consecutive IN (0, 1)),
    saved_nominal_reps INTEGER,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY (routine_exercise_id) REFERENCES RoutineExercise(id) ON DELETE CASCADE
);
