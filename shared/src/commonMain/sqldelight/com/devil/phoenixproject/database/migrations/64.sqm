-- Migration 64: Issue #1400 per-rep aggregate eligibility.
-- Calibration-contaminated and load-ramp reps are kept for the per-rep display but excluded
-- from set-level velocity aggregates. Existing rows default to eligible (1).
ALTER TABLE RepBiomechanics ADD COLUMN aggregateEligible INTEGER NOT NULL DEFAULT 1 CHECK(aggregateEligible IN (0, 1));

-- Issue #1400: set velocity loss is clamped to 0-100; legacy rows computed against a slow
-- calibration/ramp first rep stored negative values. Idempotent, so a replayed step is a no-op.
UPDATE WorkoutSession SET totalVelocityLossPercent = 0 WHERE totalVelocityLossPercent < 0;
