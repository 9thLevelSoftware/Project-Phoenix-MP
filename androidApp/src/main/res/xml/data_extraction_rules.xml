<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ data extraction rules (android:dataExtractionRules) -->
<!-- Excludes the app database and sensitive preferences from both cloud backup and device transfer -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="vitruvian.db" />
        <exclude domain="database" path="vitruvian.db-journal" />
        <exclude domain="database" path="vitruvian.db-wal" />
        <exclude domain="database" path="vitruvian.db-shm" />
        <exclude domain="database" path="phoenix.db" />
        <exclude domain="database" path="phoenix.db-journal" />
        <exclude domain="database" path="phoenix.db-wal" />
        <exclude domain="database" path="phoenix.db-shm" />
        <exclude domain="database" path="phoenix.db.migrating" />
        <exclude domain="database" path="phoenix.db.migrating-journal" />
        <exclude domain="database" path="phoenix.db.migrating-wal" />
        <exclude domain="database" path="phoenix.db.migrating-shm" />
        <exclude domain="database" path="phoenix-recovery.db" />
        <exclude domain="database" path="phoenix-recovery.db-journal" />
        <exclude domain="database" path="phoenix-recovery.db-wal" />
        <exclude domain="database" path="phoenix-recovery.db-shm" />
        <exclude domain="database" path="phoenix-db-migration.lock" />
        <exclude domain="sharedpref" path="vitruvian_preferences.xml" />
        <exclude domain="sharedpref" path="vitruvian_preferences.xml.bak" />
        <exclude domain="sharedpref" path="vitruvian_secure_preferences.xml" />
        <exclude domain="sharedpref" path="vitruvian_secure_preferences.xml.bak" />
        <exclude domain="sharedpref" path="phoenix_preferences.xml" />
        <exclude domain="sharedpref" path="phoenix_preferences.xml.bak" />
        <exclude domain="sharedpref" path="phoenix_secure_preferences.xml" />
        <exclude domain="sharedpref" path="phoenix_secure_preferences.xml.bak" />
        <exclude domain="sharedpref" path="phoenix_preferences_recovery.xml" />
        <exclude domain="sharedpref" path="phoenix_preferences_recovery.xml.bak" />
        <exclude domain="sharedpref" path="phoenix_secure_preferences_recovery.xml" />
        <exclude domain="sharedpref" path="phoenix_secure_preferences_recovery.xml.bak" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="vitruvian.db" />
        <exclude domain="database" path="vitruvian.db-journal" />
        <exclude domain="database" path="vitruvian.db-wal" />
        <exclude domain="database" path="vitruvian.db-shm" />
        <exclude domain="database" path="phoenix.db" />
        <exclude domain="database" path="phoenix.db-journal" />
        <exclude domain="database" path="phoenix.db-wal" />
        <exclude domain="database" path="phoenix.db-shm" />
        <exclude domain="database" path="phoenix.db.migrating" />
        <exclude domain="database" path="phoenix.db.migrating-journal" />
        <exclude domain="database" path="phoenix.db.migrating-wal" />
        <exclude domain="database" path="phoenix.db.migrating-shm" />
        <exclude domain="database" path="phoenix-recovery.db" />
        <exclude domain="database" path="phoenix-recovery.db-journal" />
        <exclude domain="database" path="phoenix-recovery.db-wal" />
        <exclude domain="database" path="phoenix-recovery.db-shm" />
        <exclude domain="database" path="phoenix-db-migration.lock" />
        <exclude domain="sharedpref" path="vitruvian_preferences.xml" />
        <exclude domain="sharedpref" path="vitruvian_preferences.xml.bak" />
        <exclude domain="sharedpref" path="vitruvian_secure_preferences.xml" />
        <exclude domain="sharedpref" path="vitruvian_secure_preferences.xml.bak" />
        <exclude domain="sharedpref" path="phoenix_preferences.xml" />
        <exclude domain="sharedpref" path="phoenix_preferences.xml.bak" />
        <exclude domain="sharedpref" path="phoenix_secure_preferences.xml" />
        <exclude domain="sharedpref" path="phoenix_secure_preferences.xml.bak" />
        <exclude domain="sharedpref" path="phoenix_preferences_recovery.xml" />
        <exclude domain="sharedpref" path="phoenix_preferences_recovery.xml.bak" />
        <exclude domain="sharedpref" path="phoenix_secure_preferences_recovery.xml" />
        <exclude domain="sharedpref" path="phoenix_secure_preferences_recovery.xml.bak" />
    </device-transfer>
</data-extraction-rules>
