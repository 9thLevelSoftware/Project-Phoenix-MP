<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ data extraction rules (android:dataExtractionRules) -->
<!-- Excludes Phoenix database and sensitive preferences from both cloud backup and device transfer -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="phoenix.db" />
        <exclude domain="database" path="phoenix.db-journal" />
        <exclude domain="database" path="phoenix.db-wal" />
        <exclude domain="database" path="phoenix.db-shm" />
        <exclude domain="sharedpref" path="phoenix_preferences.xml" />
        <exclude domain="sharedpref" path="phoenix_secure_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="phoenix.db" />
        <exclude domain="database" path="phoenix.db-journal" />
        <exclude domain="database" path="phoenix.db-wal" />
        <exclude domain="database" path="phoenix.db-shm" />
        <exclude domain="sharedpref" path="phoenix_preferences.xml" />
        <exclude domain="sharedpref" path="phoenix_secure_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
